{
  "name": "redirect-sentinel",
  "version": "0.0.0",
  "description": "Find open redirects and mixed content in a built site or a live crawl: http:// scripts, styles, frames and images on HTTPS pages, insecure forms, client-side redirects fed by URL parameters, open redirect rules in _redirects/vercel.json, HTTPS downgrades, and optional safe redirect probing. Zero deps.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "redirect-sentinel": "bin/redirect-sentinel.js"
  },
  "files": [
    "src",
    "bin",
    "action.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "open-redirect",
    "mixed-content",
    "https",
    "redirect",
    "crawler",
    "static-site",
    "netlify",
    "vercel",
    "web-security",
    "appsec",
    "security",
    "sarif",
    "cli",
    "github-action"
  ],
  "author": "Louis Wright <hello@louiswright.co.uk> (https://github.com/MrLouisWright)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrLouisWright/redirect-sentinel.git"
  },
  "bugs": {
    "url": "https://github.com/MrLouisWright/redirect-sentinel/issues"
  },
  "homepage": "https://github.com/MrLouisWright/redirect-sentinel#readme"
}
